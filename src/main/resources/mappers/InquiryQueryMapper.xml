<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salesboost.domain.inquiry.mapper.InquiryQueryMapper">

    <resultMap id="InquiryListItemResultMap" type="com.salesboost.domain.inquiry.dto.InquiryListItemResponse">
        <id property="id" column="id"/>
        <result property="companyName" column="company_name"/>
        <result property="contactName" column="contact_name"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="inquiryType" column="inquiry_type"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 문의 목록 조회 -->
    <select id="findInquiries" resultMap="InquiryListItemResultMap">
        SELECT
            id,
            company_name,
            contact_name,
            email,
            phone,
            inquiry_type,
            status,
            created_at
        FROM inquiries
        WHERE 1=1
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (
                company_name LIKE CONCAT('%', #{keyword}, '%')
                OR contact_name LIKE CONCAT('%', #{keyword}, '%')
                OR email LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{size}
    </select>

    <!-- 문의 전체 개수 조회 -->
    <select id="countInquiries" resultType="long">
        SELECT COUNT(*)
        FROM inquiries
        WHERE 1=1
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (
                company_name LIKE CONCAT('%', #{keyword}, '%')
                OR contact_name LIKE CONCAT('%', #{keyword}, '%')
                OR email LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
    </select>

</mapper>
