# ============================================================
# SalesBoost 환경변수 설정 파일
# ============================================================
# 사용 방법:
#   cp .env.example .env
#   .env 파일을 열어 각 값을 실제 환경에 맞게 수정하세요.
#
# ⚠️  주의: .env 파일은 절대 Git에 커밋하지 마세요! (민감 정보 포함)
#           .env.example 파일만 Git에 커밋합니다.
# ============================================================

# ------------------------------------------------------------
# [DB] MariaDB 데이터베이스 설정
# ------------------------------------------------------------
# 데이터베이스 이름 (변경 시 backend의 SPRING_DATASOURCE_URL도 함께 수정)
DB_DATABASE=salesboost

# DB root 비밀번호 – docker-compose의 mariadb 컨테이너 및 backend 양쪽에서 사용됨
# 프로덕션에서는 반드시 강력한 비밀번호로 변경하세요
DB_ROOT_PASSWORD=root

# DB 접속 사용자 이름 (기본: root)
DB_USERNAME=root

# ------------------------------------------------------------
# [Backend] Spring Boot 데이터소스 설정
# ------------------------------------------------------------
# Docker Compose 환경: 호스트명은 서비스명(mariadb)으로 설정
# 로컬 직접 실행 환경: jdbc:mariadb://127.0.0.1:3306/salesboost?allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb:3306/salesboost?allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${DB_ROOT_PASSWORD}

# ------------------------------------------------------------
# [Backend] JWT 설정
# ------------------------------------------------------------
# JWT 서명 시크릿 키 (32바이트 이상, 프로덕션에서는 반드시 변경)
# 생성 예시: openssl rand -base64 48
APP_JWT_SECRET=change-this-to-very-long-secret-key-at-least-32bytes

# ------------------------------------------------------------
# [Backend] CORS 설정
# ------------------------------------------------------------
# 허용할 오리진 목록 (쉼표로 구분)
# 로컬: http://localhost:5173,http://localhost:3000
# 프로덕션: 실제 도메인으로 변경
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000
